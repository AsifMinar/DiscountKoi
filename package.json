    "preview": "node scripts/preview.mjs",
    "screenshots": "tsx scripts/screenshots.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "make-images": "tsx scripts/make-images.ts",
    "scrape": "tsx scraper/index.ts",
    "scrape:local": "tsx scraper/index.ts --local",
    "add-pick": "tsx scripts/add-pick.ts",
    "scrape:check-time": "tsx scraper/time-gate.ts",
